{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Laser XY Scanner Protocol v1 Schema",
  "type": "object",
  "required": ["v", "type"],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "Protocol version, strictly 1"
    },
    "id": {
      "type": "string",
      "description": "Request correlation ID"
    },
    "type": {
      "type": "string",
      "description": "Frame type identifier"
    }
  },
  "discriminator": {
    "propertyName": "type"
  }
}
